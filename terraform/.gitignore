# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore backend configuration (may contain sensitive bucket names)
backend-config.tfvars

# Lock file (commit this in a team environment)
# .terraform.lock.hcl

# Build artifacts
**/build/
*.zip

# Generated registry connection file
registry-connection.xml
